# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Endereço público do app (usado nos links de e-mail). Na Vercel: https://seu-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- App instalável: notificações push (opcional) ---
# Gere com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Só no servidor (Vercel → Environment Variables, NUNCA com prefixo NEXT_PUBLIC_)
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://seu-app.vercel.app
# Segredo longo e aleatório (48+ caracteres); o mesmo vai no Supabase via configure_push
PUSH_DISPATCH_SECRET=
